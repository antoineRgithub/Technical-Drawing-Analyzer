{
  "name": "desktop-streamlit",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.streamlitapp",
    "asar": false,
    "files": [
      "electron/**/*",
      "!venv/**",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!dist/**",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "app.py",
        "to": "app.py"
      },
      {
        "from": "modules",
        "to": "modules",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"]
      },
      {
        "from": "venv",
        "to": "app/venv",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"]
      }
    ],
    "win": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}